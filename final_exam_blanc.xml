  <!-- Q1 multichoice -->
  <question type="multichoice">
    <name><text>FB-IND-01 Gauss sum</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>For every integer <em>n</em> &ge; 1, the sum 1 + 2 + 3 + &hellip; + <em>n</em> equals:</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text><![CDATA[n<sup>2</sup>]]></text><feedback format="html"><text><![CDATA[That is the sum of the first n odd numbers.]]></text></feedback></answer>
    <answer fraction="0"><text>n(n+1)</text><feedback format="html"><text><![CDATA[Off by a factor of 2.]]></text></feedback></answer>
    <answer fraction="100"><text>n(n+1)/2</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="0"><text>(n+1)/2</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
  </question>

  <!-- Q2 numerical -->
  <question type="numerical">
    <name><text>FB-IND-02 Linear recurrence</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A sequence is defined by <em>a</em><sub>1</sub> = 3 and <em>a</em><sub>n</sub> = 2 <em>a</em><sub>n&minus;1</sub> + 1 for <em>n</em> &ge; 2.</p>
      <p>Compute <em>a</em><sub>4</sub>.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>31</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 3, 7, 15, 31.]]></text></feedback></answer>
  </question>

  <!-- Q3 truefalse -->
  <question type="truefalse">
    <name><text>FB-IND-03 Strong induction</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>In strong (complete) induction, one assumes that <em>P</em>(1), <em>P</em>(2), &hellip;, <em>P</em>(<em>k</em>) are all true in order to prove <em>P</em>(<em>k</em>+1).</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>true</text><feedback format="html"><text><![CDATA[Correct: that is the strong induction hypothesis.]]></text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback format="html"><text><![CDATA[This is exactly the strong induction hypothesis.]]></text></feedback></answer>
  </question>

  <!-- Q4 shortanswer -->
  <question type="shortanswer">
    <name><text>FB-IND-04 Closed form</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A sequence satisfies <em>a</em><sub>0</sub> = 0 and <em>a</em><sub>n</sub> = <em>a</em><sub>n&minus;1</sub> + 2<em>n</em> for <em>n</em> &ge; 1.</p>
      <p>Its closed form is <em>a</em><sub>n</sub> = ______. (Write it as n^2+n.)</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <usecase>0</usecase>
    <answer fraction="100"><text>n^2+n</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="100"><text>n(n+1)</text><feedback format="html"><text><![CDATA[Correct (equivalent form).]]></text></feedback></answer>
    <answer fraction="100"><text>n*(n+1)</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="0"><text>*</text><feedback format="html"><text><![CDATA[The closed form is n^2 + n = n(n+1).]]></text></feedback></answer>
  </question>

  <!-- Q5 numerical -->
  <question type="numerical">
    <name><text>FB-IND-05 Sum of even numbers</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>Compute the sum 2 + 4 + 6 + &hellip; + 20.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>110</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 2(1+2+...+10) = 2&middot;55 = 110.]]></text></feedback></answer>
  </question>

  <!-- Q6 multichoice -->
  <question type="multichoice">
    <name><text>FB-IND-06 Recursive definition of factorial</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>In the recursive definition <em>n</em>! = <em>n</em> &middot; (<em>n</em>&minus;1)!, what is the correct base case?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text>0! = 0</text><feedback format="html"><text><![CDATA[Incorrect: 0! = 1 by definition.]]></text></feedback></answer>
    <answer fraction="100"><text>0! = 1</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="0"><text>1! = 0</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="0"><text>0! = undefined</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
  </question>

