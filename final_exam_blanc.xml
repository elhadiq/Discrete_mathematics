  <!-- Q10 truefalse -->
  <question type="truefalse">
    <name><text>FB-CNT-04 Symmetry of binomials</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>For all integers 0 &le; <em>k</em> &le; <em>n</em>, the identity C(<em>n</em>, <em>k</em>) = C(<em>n</em>, <em>n</em>&minus;<em>k</em>) holds.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>true</text><feedback format="html"><text><![CDATA[Correct: choosing k to include equals choosing n-k to exclude.]]></text></feedback></answer>
