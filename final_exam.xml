  <!-- Q7 numerical -->
  <question type="numerical">
    <name><text>FE-CNT-01 Permutations</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>In how many different orders can 5 distinct books be placed on a shelf?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>120</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 5! = 120.]]></text></feedback></answer>
  </question>

  <!-- Q8 multichoice -->
  <question type="multichoice">
    <name><text>FE-CNT-02 Binomial coefficient</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>The value of the binomial coefficient C(6, 2) is:</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text>30</text><feedback format="html"><text><![CDATA[That is P(6,2).]]></text></feedback></answer>
    <answer fraction="0"><text>12</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="0"><text>36</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="100"><text>15</text><feedback format="html"><text><![CDATA[Correct: 6!/(2!4!) = 15.]]></text></feedback></answer>
  </question>

  <!-- Q9 numerical -->
  <question type="numerical">
    <name><text>FE-CNT-03 Bit strings</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>How many bit strings (strings of 0s and 1s) of length 8 are there?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>256</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 2<sup>8</sup> = 256.]]></text></feedback></answer>
  </question>

  <!-- Q10 truefalse -->
  <question type="truefalse">
    <name><text>FE-CNT-04 Number of subsets</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A set with <em>n</em> elements has exactly 2<sup>n</sup> subsets.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>true</text><feedback format="html"><text><![CDATA[Correct: each element is in or out.]]></text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback format="html"><text><![CDATA[The power set has 2^n elements.]]></text></feedback></answer>
  </question>

  <!-- Q11 shortanswer -->
  <question type="shortanswer">
    <name><text>FE-CNT-05 Pigeonhole principle</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>By the pigeonhole principle, what is the minimum number of people needed to guarantee that at least two of them were born in the same month? (Enter a number.)</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <usecase>0</usecase>
    <answer fraction="100"><text>13</text><feedback format="html"><text><![CDATA[Correct: 12 months + 1.]]></text></feedback></answer>
    <answer fraction="0"><text>*</text><feedback format="html"><text><![CDATA[The answer is 13.]]></text></feedback></answer>
  </question>

  <!-- Q12 numerical -->
  <question type="numerical">
    <name><text>FE-CNT-06 Permutations with repetition</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>How many distinct arrangements can be made from the letters of the word <strong>LEVEL</strong>?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>30</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 5!/(2!&middot;2!) = 30.]]></text></feedback></answer>
  </question>

