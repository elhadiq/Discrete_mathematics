  <!-- Q13 multichoice -->
  <question type="multichoice">
    <name><text>FE-GRP-01 Handshaking lemma</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>In an undirected graph with 10 edges, the sum of the degrees of all vertices is:</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text>10</text><feedback format="html"><text><![CDATA[That is the number of edges, not the degree sum.]]></text></feedback></answer>
    <answer fraction="0"><text>5</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="100"><text>20</text><feedback format="html"><text><![CDATA[Correct: handshaking lemma, sum of degrees = 2 &times; (number of edges).]]></text></feedback></answer>
    <answer fraction="0"><text>100</text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
  </question>

  <!-- Q14 truefalse -->
  <question type="truefalse">
    <name><text>FE-GRP-02 Edges of a tree</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A tree with <em>n</em> vertices has exactly <em>n</em> &minus; 1 edges.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>true</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback format="html"><text><![CDATA[A tree on n vertices always has n-1 edges.]]></text></feedback></answer>
  </question>

