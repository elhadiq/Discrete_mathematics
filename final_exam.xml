<quiz>

  <!-- ================= CATEGORY ================= -->
  <question type="category">
    <category>
      <text>$course$/top/Final Exam/Induction and Recursion</text>
    </category>
    <info format="html">
      <text><![CDATA[Mathematical Induction and Recursive Definitions.]]></text>
    </info>
  </question>

  <!-- Q1 multichoice -->
  <question type="multichoice">
    <name><text>FE-IND-01 Sum of odd numbers</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>For every integer <em>n</em> &ge; 1, the sum of the first <em>n</em> odd numbers</p>
      <p style="text-align:center">1 + 3 + 5 + &hellip; + (2<em>n</em> &minus; 1)</p>
      <p>is equal to:</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text><![CDATA[n(n+1)/2]]></text><feedback format="html"><text><![CDATA[That is the sum 1+2+...+n.]]></text></feedback></answer>
    <answer fraction="0"><text><![CDATA[2<sup>n</sup> &minus; 1]]></text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="100"><text><![CDATA[n<sup>2</sup>]]></text><feedback format="html"><text><![CDATA[Correct. Proved by induction.]]></text></feedback></answer>
    <answer fraction="0"><text><![CDATA[(2n &minus; 1)<sup>2</sup>]]></text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
  </question>

  <!-- Q2 truefalse -->
  <question type="truefalse">
    <name><text>FE-IND-02 Principle of induction</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>To prove a statement <em>P</em>(<em>n</em>) for all integers <em>n</em> &ge; 1 by mathematical induction, it is sufficient to show that <em>P</em>(1) is true and that <em>P</em>(<em>k</em>) &rArr; <em>P</em>(<em>k</em>+1) for every <em>k</em> &ge; 1.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>true</text><feedback format="html"><text><![CDATA[Correct: base case plus inductive step.]]></text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback format="html"><text><![CDATA[These two steps form the principle of induction.]]></text></feedback></answer>
  </question>

  <!-- Q3 numerical -->
  <question type="numerical">
    <name><text>FE-IND-03 Arithmetic recurrence</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A sequence is defined by <em>a</em><sub>1</sub> = 2 and <em>a</em><sub>n</sub> = <em>a</em><sub>n&minus;1</sub> + 3 for <em>n</em> &ge; 2.</p>
      <p>Compute <em>a</em><sub>5</sub>.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>14</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 2, 5, 8, 11, 14.]]></text></feedback></answer>
  </question>

  <!-- Q4 shortanswer -->
  <question type="shortanswer">
    <name><text>FE-IND-04 Closed form of geometric recurrence</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A sequence satisfies <em>a</em><sub>0</sub> = 1 and <em>a</em><sub>n</sub> = 2 <em>a</em><sub>n&minus;1</sub> for <em>n</em> &ge; 1.</p>
      <p>Give the closed-form expression for <em>a</em><sub>n</sub> (write it as 2^n).</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <usecase>0</usecase>
    <answer fraction="100"><text>2^n</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="100"><text>2**n</text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="0"><text>*</text><feedback format="html"><text><![CDATA[The solution is 2^n.]]></text></feedback></answer>
  </question>

  <!-- Q5 multichoice -->
  <question type="multichoice">
    <name><text>FE-IND-05 Sum of cubes</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>For <em>n</em> &ge; 1, the sum 1<sup>3</sup> + 2<sup>3</sup> + &hellip; + <em>n</em><sup>3</sup> equals:</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text><![CDATA[n(n+1)(2n+1)/6]]></text><feedback format="html"><text><![CDATA[That is the sum of squares.]]></text></feedback></answer>
    <answer fraction="100"><text><![CDATA[( n(n+1)/2 )<sup>2</sup>]]></text><feedback format="html"><text><![CDATA[Correct: it is the square of 1+2+...+n.]]></text></feedback></answer>
    <answer fraction="0"><text><![CDATA[n<sup>2</sup>(n+1)]]></text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="0"><text><![CDATA[n(n+1)/2]]></text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
  </question>

  <!-- Q6 numerical -->
  <question type="numerical">
    <name><text>FE-IND-06 Fibonacci</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>The Fibonacci sequence is defined by <em>F</em><sub>1</sub> = 1, <em>F</em><sub>2</sub> = 1 and <em>F</em><sub>n</sub> = <em>F</em><sub>n&minus;1</sub> + <em>F</em><sub>n&minus;2</sub>.</p>
      <p>Compute <em>F</em><sub>7</sub>.</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <answer fraction="100"><text>13</text><tolerance>0</tolerance><feedback format="html"><text><![CDATA[Correct: 1, 1, 2, 3, 5, 8, 13.]]></text></feedback></answer>
  </question>

