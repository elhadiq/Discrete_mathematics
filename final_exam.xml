  <!-- Q16 multichoice -->
  <question type="multichoice">
    <name><text>FE-GRP-04 Euler circuit condition</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>A connected undirected graph has an Euler circuit if and only if:</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0"><text><![CDATA[exactly two vertices have odd degree]]></text><feedback format="html"><text><![CDATA[That is the condition for an Euler path, not a circuit.]]></text></feedback></answer>
    <answer fraction="0"><text><![CDATA[every vertex has odd degree]]></text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="0"><text><![CDATA[it has no cycles]]></text><feedback format="html"><text><![CDATA[Incorrect.]]></text></feedback></answer>
    <answer fraction="100"><text><![CDATA[every vertex has even degree]]></text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
  </question>

