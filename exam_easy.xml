  <!-- ============ PART I — LOGIC, PREDICATES & INFERENCE (Q1-Q4) ============ -->

  <question type="multichoice">
    <name><text>E1 - Double negation</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Which proposition is equivalent to \( \neg(\neg p) \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Two negations cancel out: \( \neg(\neg p) \equiv p \).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( p \)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \neg p \)]]></text><feedback format="html"><text>That is just one negation.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( p \land \neg p \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( p \lor \neg p \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>E2 - When is a conjunction true?</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> The statement \( p \land q \) is true only when both \(p\) and \(q\) are true.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>True. "AND" (\(\land\)) is true exactly when both parts are true.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>1</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="moodle_auto_format"><text>false</text><feedback format="html"><text>A conjunction needs both parts true.</text></feedback></answer>
  </question>

  <question type="matching">
    <name><text>E3 - Match each logical symbol to its name</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Match each logical symbol with its name.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\(\land\) = AND, \(\lor\) = OR, \(\neg\) = NOT, \(\rightarrow\) = implies (if … then).</p>]]></text>
    </generalfeedback>
    <defaultgrade>4</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html"><text>All correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Some correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review the symbols.</text></incorrectfeedback>
    <subquestion format="html"><text><![CDATA[∧]]></text><answer><text><![CDATA[AND]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[∨]]></text><answer><text><![CDATA[OR]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[¬]]></text><answer><text><![CDATA[NOT]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[→]]></text><answer><text><![CDATA[implies (if ... then)]]></text></answer></subquestion>
  </question>

  <question type="multichoice">
    <name><text>E4 - Negation of "for all"</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Predicates]</strong> What is the negation of \( \forall x\, P(x) \) ("for every \(x\), \(P(x)\)")?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( \neg \forall x\, P(x) \equiv \exists x\, \neg P(x) \): "there exists an \(x\) for which \(P(x)\) is false".</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( \exists x\, \neg P(x) \)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, \neg P(x) \)]]></text><feedback format="html"><text>The quantifier must change to \(\exists\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \exists x\, P(x) \)]]></text><feedback format="html"><text>You also need to negate \(P(x)\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, P(x) \)]]></text><feedback format="html"><text>That is the original statement.</text></feedback></answer>
  </question>

  <!-- ============ PART II — DISCRETE STRUCTURES (Q5-Q10) ============ -->

  <question type="numerical">
    <name><text>E5 - Sets: size of a union</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Sets]</strong> Let \( A = \{1, 2, 3\} \) and \( B = \{3, 4\} \). How many elements are in \( A \cup B \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( A \cup B = \{1, 2, 3, 4\} \), so \( |A \cup B| = 4 \) (the element 3 is counted once).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>4</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
    <unitgradingtype>0</unitgradingtype>
    <unitpenalty>0.1000000</unitpenalty>
    <showunits>3</showunits>
    <unitsleft>0</unitsleft>
  </question>

  <question type="multianswer">
    <name><text>E6 - Sets: intersection and subsets (Cloze)</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Operations on Sets]</strong> Let \( A = \{1, 2, 3\} \) and \( B = \{2, 3, 5\} \).</p>
<p>(a) The intersection \( A \cap B \) is the set {1:MULTICHOICE:=&#123;2, 3&#125;~&#123;1, 2, 3, 5&#125;~&#123;1&#125;~&#123;5&#125;}.</p>
<p>(b) The number of elements in \( A \cap B \) is {1:NUMERICAL:=2:0}.</p>
<p>(c) A set with 2 elements has {1:NUMERICAL:=4:0} subsets in total.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>(a) Common elements: \( A \cap B = \{2, 3\} \). (b) That set has 2 elements. (c) A 2-element set has \( 2^2 = 4 \) subsets.</p>]]></text>
    </generalfeedback>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
  </question>

  <question type="multichoice">
    <name><text>E7 - Relations: properties of equality</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Relations]</strong> Consider the equality relation \( = \) on numbers (\(a\,R\,b\) means \(a = b\)). Select <em>all</em> properties it has.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Equality is reflexive (\(a=a\)), symmetric (if \(a=b\) then \(b=a\)), and transitive (if \(a=b\) and \(b=c\) then \(a=c\)). It is an equivalence relation.</p>]]></text>
    </generalfeedback>
    <defaultgrade>3</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>false</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="33.33333" format="html"><text>Reflexive</text><feedback format="html"><text>Yes.</text></feedback></answer>
    <answer fraction="33.33333" format="html"><text>Symmetric</text><feedback format="html"><text>Yes.</text></feedback></answer>
    <answer fraction="33.33333" format="html"><text>Transitive</text><feedback format="html"><text>Yes.</text></feedback></answer>
  </question>

