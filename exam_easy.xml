  <!-- ============ PART III — PROOFS (Q11-Q12) ============ -->

  <question type="essay">
    <name><text>E11 - Proof by contradiction (guided)</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Proof — Contradiction]</strong> Prove by contradiction that there is no largest integer.</p>
<p><em>Hint:</em> suppose there <strong>is</strong> a largest integer \(N\). What can you say about \(N + 1\)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p><strong>Model proof.</strong> Suppose, for contradiction, that there is a largest integer \(N\). Consider \(N + 1\). Since \(N\) is an integer, \(N + 1\) is also an integer, and \(N + 1 > N\). This contradicts the assumption that \(N\) is the largest integer. Therefore no largest integer exists. \( \blacksquare \)</p>]]></text>
    </generalfeedback>
    <defaultgrade>2</defaultgrade>
    <penalty>0</penalty>
    <hidden>0</hidden>
