  <question type="multichoice">
    <name><text>M1 - Equivalent form of a biconditional</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Which proposition is logically equivalent to \( p \leftrightarrow q \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( p \leftrightarrow q \equiv (p \rightarrow q) \land (q \rightarrow p) \): the biconditional holds when each side implies the other.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( (p \rightarrow q) \land (q \rightarrow p) \)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( p \rightarrow q \)]]></text><feedback format="html"><text>Only one direction — not equivalent.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( p \land q \)]]></text><feedback format="html"><text>No — \(p\leftrightarrow q\) is also true when both are false.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \neg p \lor q \)]]></text><feedback format="html"><text>That is \(p\to q\).</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>M2 - When is a biconditional true?</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> The statement \( p \leftrightarrow q \) is true exactly when \(p\) and \(q\) have the same truth value.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>True. \(p\leftrightarrow q\) is true when both are true or both are false.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>1</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="moodle_auto_format"><text>false</text><feedback format="html"><text>Check the truth table of the biconditional.</text></feedback></answer>
  </question>

  <question type="matching">
    <name><text>M3 - Match each logical law to its form</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Match each logical equivalence law with its statement.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Associative, Distributive, Double negation, Domination laws.</p>]]></text>
    </generalfeedback>
    <defaultgrade>4</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html"><text>All correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Some correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review the laws.</text></incorrectfeedback>
    <subquestion format="html"><text><![CDATA[Associative]]></text><answer><text><![CDATA[(p AND q) AND r = p AND (q AND r)]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Distributive]]></text><answer><text><![CDATA[p OR (q AND r) = (p OR q) AND (p OR r)]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Double negation]]></text><answer><text><![CDATA[NOT(NOT p) = p]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Domination]]></text><answer><text><![CDATA[p OR True = True]]></text></answer></subquestion>
  </question>

  <question type="multichoice">
    <name><text>M4 - Negation of a universal implication</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Predicates]</strong> What is the negation of \( \forall x\, \big(P(x) \rightarrow Q(x)\big) \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( \neg\forall x\,(P(x)\to Q(x)) \equiv \exists x\,(P(x)\land\neg Q(x)) \).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( \exists x\, (P(x) \land \neg Q(x)) \)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \exists x\, (P(x) \rightarrow \neg Q(x)) \)]]></text><feedback format="html"><text>Negate the implication first.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, (P(x) \land \neg Q(x)) \)]]></text><feedback format="html"><text>The quantifier must flip to \(\exists\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \exists x\, (\neg P(x) \land Q(x)) \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="numerical">
    <name><text>M5 - Sets: inclusion-exclusion</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Sets]</strong> Let \(A, B\) be finite sets with \(|A| = 20\), \(|B| = 6\) and \(|A \cap B| = 4\). Compute \(|A \cup B|\).</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( |A \cup B| = 20 + 6 - 4 = 22. \)</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>22</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
    <unitgradingtype>0</unitgradingtype>
    <unitpenalty>0.1000000</unitpenalty>
    <showunits>3</showunits>
    <unitsleft>0</unitsleft>
  </question>

  <question type="multianswer">
    <name><text>M6 - Set operations on explicit sets (Cloze)</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Operations on Sets]</strong> Let \( A = \{2, 4, 6, 8\} \) and \( B = \{1, 2, 3, 4\} \).</p>
<p>(a) The intersection \( A \cap B \) is {1:MULTICHOICE:=&#123;2, 4&#125;~&#123;1, 2, 3, 4&#125;~&#123;6, 8&#125;~&#123;1, 3&#125;}.</p>
<p>(b) The number of elements in \( A \cup B \) is {2:NUMERICAL:=6:0}.</p>
<p>(c) The number of elements in \( A \setminus B \) (in A but not in B) is {1:NUMERICAL:=2:0}.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>(a) Common elements: {2,4}. (b) A union B = {1,2,3,4,6,8} so 6. (c) A minus B = {6,8} so 2.</p>]]></text>
    </generalfeedback>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
  </question>

  <question type="multichoice">
    <name><text>M7 - Relations: congruence modulo 4</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Relations]</strong> Define \(R\) on \( \mathbb{Z} \) by \( a\,R\,b \iff a \equiv b \pmod 4 \). Select <em>all</em> properties \(R\) has.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Congruence mod 4 is reflexive, symmetric and transitive: an equivalence relation. It is not antisymmetric.</p>]]></text>
    </generalfeedback>
    <defaultgrade>3</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>false</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="33.33333" format="html"><text>Reflexive</text><feedback format="html"><text>Yes.</text></feedback></answer>
    <answer fraction="33.33333" format="html"><text>Symmetric</text><feedback format="html"><text>Yes.</text></feedback></answer>
    <answer fraction="-100" format="html"><text>Antisymmetric</text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="33.33333" format="html"><text>Transitive</text><feedback format="html"><text>Yes.</text></feedback></answer>
  </question>

  <question type="shortanswer">
    <name><text>M8 - Functions: classify f(x)=4x-1</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Functions]</strong> Consider \( f:\mathbb{R}\to\mathbb{R},\ f(x)=4x-1 \). In one word, give the strongest correct term (injective, surjective, or bijective).</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>A non-constant affine map on R is one-to-one and onto, hence bijective, with inverse (y+1)/4.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>
    <answer fraction="100" format="moodle_auto_format"><text>bijective</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="100" format="moodle_auto_format"><text>bijection</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="50" format="moodle_auto_format"><text>injective</text><feedback format="html"><text>True, but it is also surjective.</text></feedback></answer>
  </question>

