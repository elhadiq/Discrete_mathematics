  <!-- ============ PART I — LOGIC, PREDICATES & INFERENCE (Q1-Q4) ============ -->

  <question type="multichoice">
    <name><text>MB1 - The contrapositive of an implication</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Which proposition is logically equivalent to \( p \rightarrow q \) (its contrapositive)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>The contrapositive: \( p \rightarrow q \equiv \neg q \rightarrow \neg p \).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( \neg q \rightarrow \neg p \)]]></text><feedback format="html"><text>Correct — the contrapositive.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( q \rightarrow p \)]]></text><feedback format="html"><text>That is the converse, not equivalent.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \neg p \rightarrow \neg q \)]]></text><feedback format="html"><text>That is the inverse, not equivalent.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( p \land \neg q \)]]></text><feedback format="html"><text>That is the negation of \(p\to q\).</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>MB2 - When is an implication false?</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> The implication \( p \rightarrow q \) is false only when \(p\) is true and \(q\) is false.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>True. An implication fails only in the case true \(\rightarrow\) false.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>1</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="moodle_auto_format"><text>false</text><feedback format="html"><text>Look at the truth table of \(p\to q\).</text></feedback></answer>
  </question>

  <question type="matching">
    <name><text>MB3 - Match each logical law to its form</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Match each logical equivalence law with its statement.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Commutative: \(p\land q\equiv q\land p\). De Morgan: \(\neg(p\lor q)\equiv \neg p\land\neg q\). Identity: \(p\land T\equiv p\). Idempotent: \(p\lor p\equiv p\).</p>]]></text>
    </generalfeedback>
    <defaultgrade>4</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html"><text>All correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Some correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review the laws.</text></incorrectfeedback>
    <subquestion format="html"><text><![CDATA[Commutative]]></text><answer><text><![CDATA[p∧q ≡ q∧p]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[De Morgan]]></text><answer><text><![CDATA[¬(p∨q) ≡ ¬p∧¬q]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Identity]]></text><answer><text><![CDATA[p∧T ≡ p]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Idempotent]]></text><answer><text><![CDATA[p∨p ≡ p]]></text></answer></subquestion>
  </question>

  <question type="multichoice">
    <name><text>MB4 - Negation of an existential implication</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Predicates]</strong> What is the negation of \( \exists x\, \big(P(x) \rightarrow Q(x)\big) \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( \neg\exists x\,(P(x)\to Q(x)) \equiv \forall x\,\neg(P(x)\to Q(x)) \equiv \forall x\,(P(x)\land\neg Q(x)) \).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( \forall x\, (P(x) \land \neg Q(x)) \)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, (P(x) \rightarrow \neg Q(x)) \)]]></text><feedback format="html"><text>Negate the implication first.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \exists x\, (P(x) \land \neg Q(x)) \)]]></text><feedback format="html"><text>The quantifier must flip to \(\forall\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, (\neg P(x) \lor Q(x)) \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

