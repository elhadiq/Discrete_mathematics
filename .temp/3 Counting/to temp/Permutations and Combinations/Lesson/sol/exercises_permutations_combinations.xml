</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def tiroir_min(N, k):
    """Borne de Dirichlet : ceil(N/k) sans bibliothèque."""
    if N == 0:
        return 0
    # ceil(N/k) = (N + k - 1) // k pour N, k entiers positifs.
    return (N + k - 1) // k

def a_collision(liste):
    """Vrai ssi un élément se répète dans la liste."""
    return len(set(liste)) &lt; len(liste)
