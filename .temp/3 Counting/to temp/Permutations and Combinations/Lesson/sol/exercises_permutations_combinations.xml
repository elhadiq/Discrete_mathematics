</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def binomial(n, k):
    """Coefficient binomial calculé par le triangle de Pascal."""
    if k &lt; 0 or k &gt; n:
        return 0
    # Ligne courante du triangle.
    ligne = [1]
    for i in range(1, n + 1):
        # Construire la ligne i à partir de la ligne i-1.
        nouvelle = [1]
        for j in range(1, i):
            nouvelle.append(ligne[j - 1] + ligne[j])
        nouvelle.append(1)
        ligne = nouvelle
    return ligne[k]
