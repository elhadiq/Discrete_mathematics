</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>from math import comb

def catalan(n):
    """C_n = C(2n, n) - C(2n, n+1)."""
    # comb gère déjà k &gt; n en renvoyant 0
    return comb(2 * n, n) - comb(2 * n, n + 1)
