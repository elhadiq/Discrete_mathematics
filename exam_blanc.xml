  <!-- ============ PART I — LOGIC, PREDICATES & INFERENCE (Q1-Q4) ============ -->

  <question type="multichoice">
    <name><text>B1 - Logical equivalence of a negated disjunction</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Logic]</strong> Which proposition is logically equivalent to \( \neg(p \lor q) \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>By De Morgan, \( \neg(p \lor q) \equiv \neg p \land \neg q \).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( \neg p \land \neg q \)]]></text><feedback format="html"><text>Correct — De Morgan.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \neg p \lor \neg q \)]]></text><feedback format="html"><text>That is \(\neg(p \land q)\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( p \land q \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \neg p \land q \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

