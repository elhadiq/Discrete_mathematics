  <question type="numerical">
    <name><text>B5 - Sets: inclusion-exclusion</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Sets]</strong> Let \(A\) and \(B\) be finite sets with \(|A| = 15\), \(|B| = 20\) and \(|A \cap B| = 7\). Compute \(|A \cup B|\).</p>]]></text>
    </questiontext>
