  <question type="matching">
    <name><text>B3 - Match each rule of inference to its form</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Inference]</strong> Match each rule of inference with its symbolic form (premises \( \vdash \) conclusion).</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Addition: \(p \vdash p\lor q\). Simplification: \(p\land q \vdash p\). Conjunction: \(p,\;q \vdash p\land q\). Resolution: \(p\lor q,\; \neg p\lor r \vdash q\lor r\).</p>]]></text>
    </generalfeedback>
    <defaultgrade>4</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html"><text>All matches correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Some matches are correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>None correct — review the inference rules.</text></incorrectfeedback>
    <subquestion format="html"><text><![CDATA[Addition]]></text><answer><text><![CDATA[p ⊢ p∨q]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Simplification]]></text><answer><text><![CDATA[p∧q ⊢ p]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Conjunction]]></text><answer><text><![CDATA[p, q ⊢ p∧q]]></text></answer></subquestion>
    <subquestion format="html"><text><![CDATA[Resolution]]></text><answer><text><![CDATA[p∨q, ¬p∨r ⊢ q∨r]]></text></answer></subquestion>
  </question>

  <question type="multichoice">
    <name><text>B4 - Negation of an existential statement</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>[Predicates]</strong> What is the negation of \( \exists x\, \big(P(x) \land Q(x)\big) \)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\( \neg \exists x\,(P(x)\land Q(x)) \equiv \forall x\, \neg(P(x)\land Q(x)) \equiv \forall x\,(\neg P(x) \lor \neg Q(x)) \).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Incorrect.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[\( \forall x\, (\neg P(x) \lor \neg Q(x)) \)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, (\neg P(x) \land \neg Q(x)) \)]]></text><feedback format="html"><text>De Morgan turns \(\land\) into \(\lor\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \exists x\, (\neg P(x) \lor \neg Q(x)) \)]]></text><feedback format="html"><text>The quantifier must flip to \(\forall\).</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[\( \forall x\, (P(x) \rightarrow Q(x)) \)]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

